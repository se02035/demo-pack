# Copy to agents/env_sandbox_agent/.env (ADK loads per-agent .env automatically).
# Do not commit .env — it may contain project-specific resource names.

GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID

# Model location (may be `global`). Independent of SANDBOX_LOCATION.
GOOGLE_CLOUD_LOCATION=global

# Sandbox region — must be a real region, not global/us/eu.
SANDBOX_LOCATION=us-central1

# Create once with: python scripts/bootstrap_runtime.py
# (from geap/agent-sandboxes). The printed name often uses the project number.
SANDBOX_RUNTIME_NAME=projects/YOUR_GCP_PROJECT_ID/locations/us-central1/reasoningEngines/RUNTIME_ID

SANDBOX_TTL_SECONDS=3600
SANDBOX_PROVISION_DEADLINE_SECONDS=180
SANDBOX_MAX_OUTPUT_CHARS=20000

# Optional model override (default gemini-3.8-flash).
# SANDBOX_AGENT_MODEL=gemini-3.8-flash
