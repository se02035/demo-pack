# Code Execution sandbox agent — one sandbox per ADK session via
# AgentEngineSandboxCodeExecutor (no static sandbox_resource_name).
#
# Copy to agents/code_exec_agent/.env (ADK loads per-agent .env automatically).
# Do not commit .env files.

GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT

# Model location. May be a region or `global`. Independent of SANDBOX_LOCATION.
GOOGLE_CLOUD_LOCATION=global

# Sandbox / runtime location. Must be a supported region — NOT `global`, `us`, or `eu`.
SANDBOX_LOCATION=us-central1

# Created once by: python scripts/bootstrap_runtime.py
# The printed name often embeds the project *number*, not the project id — that is expected.
SANDBOX_RUNTIME_NAME=projects/YOUR_GCP_PROJECT/locations/us-central1/reasoningEngines/RUNTIME_ID

# Optional model override (defaults to gemini-3.8-flash).
# CODE_EXEC_AGENT_MODEL=gemini-3.8-flash
