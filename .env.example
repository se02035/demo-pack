# Copy to agents/sandbox_agent/.env (ADK loads per-agent .env automatically).

GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=crafty-progress-421108

# Model location. May be a region or `global`, and is independent of
# SANDBOX_LOCATION. Not every model id resolves in every location:
# `gemini-2.5-flash` works in us-central1, `gemini-flash-latest` only at global.
GOOGLE_CLOUD_LOCATION=us-central1

# Sandbox location. Must be a supported region — NOT `global`, `us`, or `eu`.
SANDBOX_LOCATION=us-central1

# Created once by: python scripts/bootstrap_runtime.py
SANDBOX_RUNTIME_NAME=projects/crafty-progress-421108/locations/us-central1/reasoningEngines/RUNTIME_ID

SANDBOX_TTL_SECONDS=3600
SANDBOX_DEFAULT_TIMEOUT_SECONDS=120
SANDBOX_PROVISION_DEADLINE_SECONDS=180
SANDBOX_MAX_OUTPUT_CHARS=20000
SANDBOX_IDLE_PAUSE_SECONDS=600
SANDBOX_IDLE_DELETE_SECONDS=3600
SANDBOX_DISPLAY_NAME_PREFIX=adk-demo

# Optional model override (defaults to gemini-2.5-flash, which resolves in
# us-central1 so the model and the sandbox share a region).
# SANDBOX_AGENT_MODEL=gemini-2.5-flash
